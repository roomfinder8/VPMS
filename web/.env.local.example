# Copy this file to .env.local and fill in the real values.
# .env* is git-ignored, so it is never committed.
# The same values also need to go into Vercel -> Settings -> Environment Variables.

# --- Supabase (the VPMS project, separate from RoomFinder) ------------------
# From Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Secret / service-role key - bypasses RLS, server-side only.
# It must never start with NEXT_PUBLIC_ or it would end up in the browser bundle.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- Gmail SMTP (report emails) --------------------------------------------
# Turn on 2-Step Verification on the sending account first, then create an App
# Password at https://myaccount.google.com/apppasswords
# Sixteen characters, with or without spaces (the code strips them).
# A normal Gmail password will not work here.
GMAIL_USER=roomfinder8888@gmail.com
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=VPMS - ETTP Visitor Parking Management

# --- Cron ------------------------------------------------------------------
# A long random string so nobody else can trigger the report endpoint.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- App -------------------------------------------------------------------
# The deployed URL, used for the "open in the app to review" link in the email.
NEXT_PUBLIC_APP_URL=http://localhost:3000
